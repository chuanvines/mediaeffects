#!/usr/bin/env bash
# mediaeffects.sh - apply effects to images and videos
#
# Install:
#   curl -fsSL <URL>/mediaeffects.sh -o mediaeffects.sh
#   bash mediaeffects.sh install
#   mediaeffects --help
#
# Or run directly without installing:
#   bash mediaeffects.sh in.png out.png --invert --fisheye 1 --hsv 180,0,0
#
# Requires: ffmpeg, ffprobe and ImageMagick (magick) on PATH.
set -euo pipefail

HIDE=0
INPUT=""
OUTPUT=""
FX_TYPES=()
FX_PARAMS=()
CLEANUP=""

log() { [ "$HIDE" -eq 0 ] && printf '[mediaeffects] %s\n' "$*"; true; }
err() { printf 'mediaeffects: error: %s\n' "$*" >&2; exit 1; }

run() {
    [ "$HIDE" -eq 0 ] && printf '[mediaeffects] exec: %s\n' "$*"
    "$@" || { err "command failed: $*"; exit 1; }
}

cleanup() { [ -n "$CLEANUP" ] && rm -rf "$CLEANUP"; true; }
trap cleanup EXIT

is_num() { [[ "$1" =~ ^-?[0-9]+(\.[0-9]+)?([eE][-+]?[0-9]+)?$ ]]; }
is_csv() { [[ "$1" =~ ^-?[0-9]+(\.[0-9]+)?([,;]-?[0-9]+(\.[0-9]+)?)*$ ]]; }
is_size() { [[ "$1" =~ ^[0-9]+([xX][0-9]+)?%?$ ]]; }

ext() { printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]'; }

is_img() { case "$(ext "$1")" in png|jpg|jpeg|gif) return 0;; esac; return 1; }
is_vid() { case "$(ext "$1")" in mp4|mov|mxf|mkv|avi) return 0;; esac; return 1; }

fx_name() {
    case "$1" in
        invert) echo invert;; invertlum) echo invertlum;; fisheye) echo fisheye;;
        hsv) echo hsv;; hue) echo hue;; explode) echo explode;; swirl) echo swirl;;
        hflip) echo hflip;; vflip) echo vflip;; rotate) echo rotate;; magik) echo magik;;
        haah) echo haah;; waaw) echo waaw;; hooh) echo hooh;; woow) echo woow;;
        stretch) echo stretch;; resize) echo resize;; derain) echo derain;;
        rain) echo rain;; bgr) echo bgr;; wave) echo wave;;
    esac
}

fx_file() { echo "effects/$(fx_name "$1").c"; }

add_fx() { FX_TYPES+=("$1"); FX_PARAMS+=("${2:-}"); }

# Effects that can be expressed purely as ffmpeg filters. When every requested
# effect is in this set, videos are processed with a single ffmpeg command and
# no intermediate frames are written at all.
uses_ffmpeg() {
    case "$1" in invert|bgr|fisheye|hflip|vflip|rotate|stretch|wave|haah|waaw|hooh|woow|resize) return 0;; esac
    return 1
}

help() {
    cat <<'EOF'
mediaeffects - apply effects to images and videos

Usage:
  mediaeffects <input> <output> [effects...] [options]

Effects:
  --invert              Negate colors (ffmpeg -vf negate style)
  --invertlum           Invert luminosity in LAB colorspace
                        (ImageMagick -colorspace lab -channel r -negate style)
  --fisheye [strength]  Fisheye distortion, default 0.5 (ffmpeg geq style)
  --hsv H,S,V           Hue shift in degrees, saturation and value shifts
                        (0 = no change). e.g. --hsv 180,0,0
                        (ImageMagick -modulate style)
  --hue [degrees]       Rotate hue in degrees, default 90 (ImageMagick
                        -colorspace yuv -fx channel rotation style)
  --explode [strength]  Explode outward, default 1.0 (-implode style)
  --swirl [strength]    Swirl in degrees, default 45 (-swirl style)
  --hflip               Mirror horizontally (ffmpeg -vf hflip)
  --vflip               Mirror vertically (ffmpeg -vf vflip)
  --rotate [degrees]    Rotate by degrees, default 90 (ffmpeg -vf rotate)
  --magik               Liquid-rescale to 50%x50%, then resize 200%
  --haah                Mirror left half onto right (ffmpeg crop/hflip/hstack)
  --waaw                Flop, then mirror left half onto right
  --hooh                Rotate 90, mirror half, rotate back
  --woow                Rotate 90 + flop, mirror half, rotate back
  --stretch [x,y]       Stretch/squeeze horizontally and vertically,
                        default 1.1,1.1 (ffmpeg geq style)
                        numbers separated by , or ;
  --resize [WxH|W|N%]   Resize with ffmpeg scale, e.g. 1280x720, 500, 50%
  --derain              Fake derain color trick (ImageMagick colorspace)
  --rain                Fake rain color trick (ImageMagick colorspace)
  --bgr                 Swap color channels to BGR (ffmpeg colorchannelmixer)
  --wave [params]       Sinusoidal wave distortion (ffmpeg geq style).
                        params: xfreq,yfreq,xamp,yamp,xphase,yphase[,xspeed,yspeed]
                        default 3.2,3.2,0.05,0.05,0.628,0.628,0,0
                        numbers separated by , or ;

Options:
  --hidelogs            Hide progress logs
  --help                Show this help and exit
  install               Copy this script into your PATH (self-install)

Supported formats:
  Images: .png .jpg .jpeg .gif
  Videos: .mp4 .mov .mxf .mkv .avi

Videos whose effects are all expressible as ffmpeg filters are encoded in a
single pass with no intermediate files. When ImageMagick is required, frames
are extracted as lossless JPEG 2000 (.jp2), processed in parallel chunks, and
reassembled with ffmpeg.

Effect source code is generated into the effects/ folder
(invert.c, invertlum.c, fisheye.c, hsv.c, hue.c, explode.c, swirl.c, hflip.c,
vflip.c, rotate.c, magik.c, haah.c, waaw.c, hooh.c, woow.c, stretch.c,
resize.c, derain.c, rain.c, bgr.c, wave.c).

Examples:
  mediaeffects in.png out.png --invert
  mediaeffects in.png out.png --invert --fisheye 1 --hsv 180,0,0
  mediaeffects clip.mp4 out.mp4 --fisheye 0.5 --hsv 45,20,-10
EOF
}

install_me() {
    local src="$0" dest
    if [ ! -f "$src" ]; then
        printf 'mediaeffects: cannot self-install while streaming (curl | bash).\n' >&2
        printf 'Download it first, then install:\n' >&2
        printf '  curl -fsSL <URL>/mediaeffects.sh -o mediaeffects.sh\n' >&2
        printf '  bash mediaeffects.sh install\n' >&2
        exit 1
    fi
    if [ "$(id -u)" -eq 0 ] && [ -d /usr/local/bin ]; then
        dest=/usr/local/bin/mediaeffects
    else
        mkdir -p "$HOME/.local/bin" || true
        dest="$HOME/.local/bin/mediaeffects"
    fi
    cp "$src" "$dest"
    chmod +x "$dest"
    printf 'Installed mediaeffects to %s\n' "$dest"
    printf 'Now run: mediaeffects --help\n'
}

fisheye_vf() {
    printf "format=yuv444p16le,geq='p(W*0.5+(X-W*0.5)*max(1-(%s)*gauss(-3.3333*pow(hypot((X-W*0.5)/(W*0.5),(Y-H*0.5)/(H*0.5)),2)),0),H*0.5+(Y-H*0.5)*max(1-(%s)*gauss(-3.3333*pow(hypot((X-W*0.5)/(W*0.5),(Y-H*0.5)/(H*0.5)),2)),0))',scale=iw:ih,format=yuv420p" "$1" "$1"
}

# stretch x,y: enlarge the canvas 1.1x, sample with /x and /y, crop back to
# the input dimensions (dims = "WxH").
stretch_vf() {
    local p="$1" dims="$2" x y
    x=${p%%,*}; y=${p#*,}
    printf "format=yuv444p,rotate=0:iw*1.1:ih*1.1,geq='p((W/2)+(X-(W/2))/%s,(H/2)+(Y-(H/2))/%s)',scale=iw:ih,crop=%s,format=yuv420p" \
        "$x" "$y" "${dims//x/:}"
}

# wave xfreq,yfreq,xamp,yamp,xphase,yphase,xspeed,yspeed: resample to a 640x640
# square, apply a sinusoidal displacement, then scale back to the input dims.
wave_vf() {
    local p="$1" dims="$2" xf yf xa ya xp yp xs ys
    IFS=, read -r xf yf xa ya xp yp xs ys <<< "$p"
    printf "format=yuv444p,scale=640:640,geq='p(X-((sin((T*5*%s+(%s))+(Y/H)*(PI*%s)))*(-%s*600)),Y-((sin((T*5*%s+(%s))+(X/W)*(PI*%s)))*(-%s*600)))',scale=%s,format=yuv420p" \
        "$xs" "$xp" "$xf" "$xa" "$ys" "$yp" "$yf" "$ya" "${dims//x/:}"
}

# resize WxH / W / N% -> ffmpeg scale filter (keeps aspect, even dims).
resize_vf() {
    local p="$1" W H pct
    case "$p" in
        *x*|*X*)
            W=${p%%[xX]*}; H=${p##*[xX]}
            echo "scale=$W:$H:force_original_aspect_ratio=decrease:force_divisible_by=2"
            ;;
        *%*)
            pct=${p%\%}
            echo "scale=trunc(iw*$pct/100/2)*2:trunc(ih*$pct/100/2)*2"
            ;;
        *)
            echo "scale=$p:-2"
            ;;
    esac
}

# ffmpeg filter string for a single effect (dims = "WxH", only used by
# stretch/wave which need to scale back to the source dimensions).
ffmpeg_vf() {
    case "$1" in
        invert) echo "format=rgb24,negate";;
        hflip) echo "hflip";;
        vflip) echo "vflip";;
        rotate) echo "rotate=${2}*3.141592653589793/180";;
        fisheye) fisheye_vf "$2";;
        stretch) stretch_vf "$2" "$3";;
        wave) wave_vf "$2" "$3";;
        bgr) echo "colorchannelmixer=rr=0:rg=0:rb=1:gr=0:gg=1:gb=0:br=1:bg=0:bb=0";;
        haah) echo "crop=iw/2:ih:0:0,split[a][b];[b]hflip[c];[a][c]hstack=inputs=2";;
        waaw) echo "hflip,crop=iw/2:ih:0:0,split[a][b];[b]hflip[c];[a][c]hstack=inputs=2";;
        hooh) echo "transpose=1,crop=iw/2:ih:0:0,split[a][b];[b]hflip[c];[a][c]hstack=inputs=2,transpose=2";;
        woow) echo "transpose=1,hflip,crop=iw/2:ih:0:0,split[a][b];[b]hflip[c];[a][c]hstack=inputs=2,transpose=2";;
        resize) resize_vf "$2";;
    esac
}

# Normalize a wave parameter string to exactly 8 values (missing -> 0).
pad_wave() {
    local s="$1"
    local -a a
    IFS=, read -r -a a <<< "$s"
    while [ "${#a[@]}" -lt 8 ]; do a+=("0"); done
    echo "${a[0]},${a[1]},${a[2]},${a[3]},${a[4]},${a[5]},${a[6]},${a[7]}"
}

magick_arg() {
    case "$1" in
        invertlum) echo " -colorspace lab -channel r -negate +colorspace";;
        hsv)
            IFS=, read -r h s v <<< "$2"
            read -r vp sp hp <<< "$(awk -v h="$h" -v s="$s" -v v="$v" \
                'BEGIN { printf "%d %d %d", 100+v, 100+s, 100 + h*100/180 }')"
            echo " -modulate $vp,$sp,$hp"
            ;;
        hue) echo " -colorspace yuv -fx angle=${2}*pi/180;channel(u,.5+(u.g-.5)*cos(angle)-(u.b-.5)*sin(angle),.5+(u.g-.5)*sin(angle)+(u.b-.5)*cos(angle)) -colorspace srgb";;
        explode) echo " -implode $(awk -v a="$2" 'BEGIN { printf "%.4f", -a }')";;
        swirl) echo " -swirl $2";;
        magik) echo " -liquid-rescale 50%x50% -resize 200%";;
        derain) echo " -colorspace srgb -set colorspace rgb -colorspace hsv -set colorspace rgb";;
        rain) echo " -colorspace srgb -set colorspace hsv -colorspace scrgb -set colorspace srgb";;
    esac
}

# Group consecutive effects into segments of one kind ("ffmpeg" or "magick").
# Consecutive ffmpeg effects are merged into a single filtergraph and
# consecutive magick effects into a single ImageMagick command, so each pass
# decodes/encodes the frames only once per kind switch.
SEG_TYPES=()
SEG_ARGS=()
build_segments() {
    local dims="$1" n=${#FX_TYPES[@]} i cur="" vf marg
    SEG_TYPES=(); SEG_ARGS=()
    for ((i = 0; i < n; i++)); do
        if uses_ffmpeg "${FX_TYPES[$i]}"; then
            vf=$(ffmpeg_vf "${FX_TYPES[$i]}" "${FX_PARAMS[$i]}" "$dims")
            if [ "$cur" = ffmpeg ]; then
                SEG_ARGS[$(( ${#SEG_ARGS[@]} - 1 ))]="${SEG_ARGS[$(( ${#SEG_ARGS[@]} - 1 ))]},$vf"
            else
                cur=ffmpeg; SEG_TYPES+=("ffmpeg"); SEG_ARGS+=("$vf")
            fi
        else
            marg=$(magick_arg "${FX_TYPES[$i]}" "${FX_PARAMS[$i]}")
            if [ "$cur" = magick ]; then
                SEG_ARGS[$(( ${#SEG_ARGS[@]} - 1 ))]="${SEG_ARGS[$(( ${#SEG_ARGS[@]} - 1 ))]}$marg"
            else
                cur=magick; SEG_TYPES+=("magick"); SEG_ARGS+=("$marg")
            fi
        fi
    done
}

write_effect_c() {
    local name="$1" p="$2" h s v vp sp hp neg
    mkdir -p effects
    case "$name" in
        invert)
            cat > effects/invert.c <<'EOF'
/*
 * invert.c
 * Effect      : invert
 * Description : negate colors
 * Generated by: mediaeffects
 *
 * CLI equivalent:
 *   ffmpeg -i <input> -vf format=rgb24,negate <output>
 *
 * Style reference: ffmpeg negate filter (libavfilter/vf_negate.c)
 */

#include <stddef.h>

/* ffmpeg filter string equivalent to: -vf format=rgb24,negate */
const char *const mediaeffects_invert_vf = "format=rgb24,negate";

/* pixel-level operation: out = max - in */
static unsigned int mediaeffects_invert_pixel(unsigned int v, unsigned int max)
{
    return max - v;
}
EOF
            ;;
        invertlum)
            cat > effects/invertlum.c <<'EOF'
/*
 * invertlum.c
 * Effect      : invertlum
 * Description : invert luminosity in LAB colorspace
 * Generated by: mediaeffects
 *
 * CLI equivalent:
 *   magick <input> -colorspace lab -channel r -negate +colorspace <output>
 *
 * Style reference: ImageMagick -colorspace, -channel, -negate
 */

#include <stddef.h>

/* ImageMagick option string (negate the L channel of LAB) */
const char *const mediaeffects_invertlum_magick = "-colorspace lab -channel r -negate +colorspace";
EOF
            ;;
        fisheye)
            cat > effects/fisheye.c <<EOF
/*
 * fisheye.c
 * Effect      : fisheye
 * Strength    : $p
 * Generated by: mediaeffects
 *
 * CLI equivalent:
 *   ffmpeg -i <input> -vf format=yuv444p16le,"geq='...'",scale=iw:ih,format=yuv420p <output>
 *
 * Style reference: ffmpeg geq filter (libavfilter/vf_geq.c)
 */

#include <stddef.h>

/* ffmpeg filter string; samples source pixels via p(x,y) */
const char *const mediaeffects_fisheye_vf =
    "format=yuv444p16le,"
    "geq='p(W*0.5+(X-W*0.5)*max(1-($p)*gauss(-3.3333*pow(hypot((X-W*0.5)/(W*0.5),(Y-H*0.5)/(H*0.5)),2)),0),"
    "H*0.5+(Y-H*0.5)*max(1-($p)*gauss(-3.3333*pow(hypot((X-W*0.5)/(W*0.5),(Y-H*0.5)/(H*0.5)),2)),0))',"
    "scale=iw:ih,format=yuv420p";
EOF
            ;;
        hsv)
            IFS=, read -r h s v <<< "$p"
            read -r vp sp hp <<< "$(awk -v h="$h" -v s="$s" -v v="$v" \
                'BEGIN { printf "%d %d %d", 100+v, 100+s, 100 + h*100/180 }')"
            cat > effects/hsv.c <<EOF
/*
 * hsv.c
 * Effect      : hsv
 * Hue         : $h deg shift (no change: 0)
 * Saturation  : $s shift (no change: 0)
 * Value       : $v shift (no change: 0)
 * Generated by: mediaeffects
 *
 * CLI equivalent:
 *   magick <input> -modulate $vp,$sp,$hp <output>
 *
 * Style reference: ImageMagick -modulate brightness,saturation,hue
 */

#include <stddef.h>

/* ImageMagick option string (brightness,saturation,hue percent) */
const char *const mediaeffects_hsv_magick = "-modulate $vp,$sp,$hp";
EOF
            ;;
        hue)
            cat > effects/hue.c <<EOF
/*
 * hue.c
 * Effect      : hue
 * Angle       : $p degrees
 * Generated by: mediaeffects
 *
 * CLI equivalent:
 *   magick <input> -colorspace yuv -fx "angle=$p*pi/180; channel(u,.5+(u.g-.5)*cos(angle)-(u.b-.5)*sin(angle),.5+(u.g-.5)*sin(angle)+(u.b-.5)*cos(angle))" -colorspace srgb <output>
 *
 * Style reference: ImageMagick -colorspace, -fx channel rotation
