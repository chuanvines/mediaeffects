EOF
            ;;
        resize)
            cat > effects/resize.c <<EOF
/*
 * resize.c
 * Effect      : resize
 * Size        : $p
 * Generated by: mediaeffects
 *
 * CLI equivalent:
 *   ffmpeg -i <input> -vf $(resize_vf "$p") <output>
 *
 * Style reference: ffmpeg scale filter
 */

#include <stddef.h>

/* ffmpeg filter string */
const char *const mediaeffects_resize_vf = "$(resize_vf "$p")";
EOF
            ;;
        derain)
            cat > effects/derain.c <<'EOF'
/*
 * derain.c
 * Effect      : derain
 * Description : fake derain color trick
 * Generated by: mediaeffects
 *
 * CLI equivalent:
 *   magick <input> -colorspace srgb -set colorspace rgb -colorspace hsv -set colorspace rgb <output>
 *
 * Style reference: ImageMagick -colorspace, -set colorspace
 */

#include <stddef.h>

/* ImageMagick option string */
const char *const mediaeffects_derain_magick = "-colorspace srgb -set colorspace rgb -colorspace hsv -set colorspace rgb";
EOF
            ;;
        rain)
            cat > effects/rain.c <<'EOF'
/*
 * rain.c
 * Effect      : rain
 * Description : fake rain color trick
 * Generated by: mediaeffects
 *
 * CLI equivalent:
 *   magick <input> -colorspace srgb -set colorspace hsv -colorspace scrgb -set colorspace srgb <output>
 *
 * Style reference: ImageMagick -colorspace, -set colorspace
 */

#include <stddef.h>

/* ImageMagick option string */
const char *const mediaeffects_rain_magick = "-colorspace srgb -set colorspace hsv -colorspace scrgb -set colorspace srgb";
EOF
            ;;
        bgr)
            cat > effects/bgr.c <<'EOF'
/*
 * bgr.c
 * Effect      : bgr
 * Description : swap color channels to BGR
 * Generated by: mediaeffects
 *
 * CLI equivalent:
 *   ffmpeg -i <input> -vf colorchannelmixer=rr=0:rg=0:rb=1:gr=0:gg=1:gb=0:br=1:bg=0:bb=0 <output>
 *
 * Style reference: ffmpeg colorchannelmixer filter
 */

#include <stddef.h>

/* ffmpeg filter string (swap R and B) */
const char *const mediaeffects_bgr_vf =
    "colorchannelmixer=rr=0:rg=0:rb=1:gr=0:gg=1:gb=0:br=1:bg=0:bb=0";
EOF
            ;;
        wave)
            cat > effects/wave.c <<EOF
/*
 * wave.c
 * Effect      : wave
 * Params      : $p
 * Generated by: mediaeffects
 *
 * CLI equivalent:
 *   ffmpeg -i <input> -vf format=yuv444p,scale=640:640,"geq='p(X-((sin((T*5*<xs>+(<xp>))+(Y/H)*(PI*<xf>)))*(-<xa>*600)),Y-((sin((T*5*<ys>+(<yp>))+(X/W)*(PI*<yf>)))*(-<ya>*600)))'",scale=<w>:<h>,format=yuv420p <output>
 *
 * Style reference: ffmpeg geq filter
 */

#include <stddef.h>

/* ffmpeg filter string (xfreq,yfreq,xamp,yamp,xphase,yphase,xspeed,yspeed) */
const char *const mediaeffects_wave_vf =
    "format=yuv444p,scale=640:640,"
    "geq='p(X-((sin((T*5*<xs>+(<xp>))+(Y/H)*(PI*<xf>)))*(-<xa>*600)),"
    "Y-((sin((T*5*<ys>+(<yp>))+(X/W)*(PI*<yf>)))*(-<ya>*600)))',"
    "scale=<w>:<h>,format=yuv420p";
EOF
            ;;
    esac
    log "effect: $(fx_name "$name") -> $(fx_file "$name")"
}

process_image() {
    local n=${#FX_TYPES[@]} i dims in="$INPUT" out segs
    if [ "$n" -eq 0 ]; then
        run magick "$INPUT" "$OUTPUT"
        return
    fi
    CLEANUP=$(mktemp -d)
    dims=$(magick "$INPUT" -format '%wx%h' info:)
    build_segments "$dims"
    local ns=${#SEG_TYPES[@]}
    for ((i = 0; i < ns; i++)); do
        if [ "$i" -eq $((ns - 1)) ]; then out="$OUTPUT"; else out="$CLEANUP/fx_$i.png"; fi
        log "processing: ${SEG_TYPES[$i]} pass $((i + 1))/$ns"
        if [ "${SEG_TYPES[$i]}" = magick ]; then
            # shellcheck disable=SC2086
            run magick "$in" ${SEG_ARGS[$i]} "$out"
        else
            run ffmpeg -y -v error -i "$in" -vf "${SEG_ARGS[$i]}" "$out"
        fi
        in="$out"
    done
}

get_video_fps() {
    local fps
    fps=$(ffprobe -v error -select_streams v:0 -show_entries stream=avg_frame_rate \
          -of csv=p=0 -i "$1" 2>/dev/null || true)
    case "$fps" in "" | "0/0") echo 25;; *) echo "$fps";; esac
}

video_pass_magick() {
    local dir="$1" cur="$2" next="$3" args="$4" d="$1" nframes cores chunk hi start pid f status=0
    local -a pids=() files
    # On MSYS2/Git Bash, native magick.exe cannot open POSIX /tmp paths, so
    # convert to a Windows path when cygpath is available (Linux passes through).
    if command -v cygpath >/dev/null 2>&1; then
        d=$(cygpath -w "$dir")
    fi
    nframes=$(ls "$dir/${cur}_"*.jp2 2>/dev/null | wc -l)
    if [ "$nframes" -le 1 ]; then
        # shellcheck disable=SC2086
        run magick "$d/${cur}_*.jp2" $args -quality 100 "$d/${next}_%05d.jp2"
        return
    fi
    cores=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)
    [ "$cores" -gt "$nframes" ] && cores=$nframes
    if [[ "$args" == *-fx* ]]; then
        # The -fx operator collapses any input sequence to a single output
        # image, so an fx-based segment (e.g. hue) must run one magick per
        # frame. Keep the parallel structure by processing frames in waves of
        # at most $cores.
        for ((start = 0; start < nframes; start += cores)); do
            hi=$(( start + cores - 1 ))
            [ "$hi" -ge "$nframes" ] && hi=$(( nframes - 1 ))
            pids=()
            for ((f = start; f <= hi; f++)); do
                ff=$(printf '%05d' "$f")
                # shellcheck disable=SC2086
                magick "$d/${cur}_${ff}.jp2" $args -quality 100 -scene "$f" \
                    "$d/${next}_%05d.jp2" &
                pids+=("$!")
            done
            for pid in "${pids[@]}"; do wait "$pid" || status=1; done
        done
        [ "$status" -eq 0 ] || err "magick frame pass failed"
        return
    fi
    chunk=$(( (nframes + cores - 1) / cores ))
    # JPEG 2000 does not support ImageMagick [N-M] frame ranges (they are read
    # as tile indices), so each chunk's frames are passed as an explicit file
    # list. Shrink the chunk if the list would overflow the command line.
    while [ "$chunk" -gt 1 ] && [ $(( chunk * ( ${#dir} + ${#cur} + 40 ) + ${#args} )) -gt 28000 ]; do
        chunk=$(( (chunk + 1) / 2 ))
    done
    # Process disjoint frame ranges in parallel; -scene keeps the output
    # numbering aligned with each chunk's starting frame.
    for ((start = 0; start < nframes; start += chunk)); do
        hi=$(( start + chunk - 1 ))
        [ "$hi" -ge "$nframes" ] && hi=$(( nframes - 1 ))
        files=()
        for ((f = start; f <= hi; f++)); do
            files+=("$d/${cur}_$(printf '%05d' "$f").jp2")
        done
        # shellcheck disable=SC2086
        magick "${files[@]}" $args -quality 100 -scene "$start" "$d/${next}_%05d.jp2" &
        pids+=("$!")
    done
    for pid in "${pids[@]}"; do
        wait "$pid" || status=1
    done
    [ "$status" -eq 0 ] || err "magick frame pass failed"
}

video_pass_ffmpeg() {
    local dir="$1" cur="$2" next="$3" vf="$4"
    run ffmpeg -y -v error -start_number 0 -i "$dir/${cur}_%05d.jp2" -vf "$vf" \
        -c:v jpeg2000 -compression_level 0 -start_number 0 "$dir/${next}_%05d.jp2"
}

process_video() {
    local dir fps dims cur=f next i ns
    if [ "${#FX_TYPES[@]}" -eq 0 ]; then
        run ffmpeg -y -v error -i "$INPUT" -map 0:v -map 0:a? -c copy "$OUTPUT"
        return
    fi
    command -v ffprobe >/dev/null || err "ffprobe not found on PATH (needed for video)"
    dims=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height \
           -of csv=s=x:p=0 "$INPUT")
    build_segments "$dims"
    ns=${#SEG_TYPES[@]}

    # Fast path: every effect is an ffmpeg filter, so do it in one pass with no
    # intermediate frames at all.
    if [ "$ns" -eq 1 ] && [ "${SEG_TYPES[0]}" = ffmpeg ]; then
        run ffmpeg -y -v error -i "$INPUT" -vf "${SEG_ARGS[0]}" \
            -c:v libx264 -crf 18 -preset veryfast -pix_fmt yuv420p \
            -c:a aac -b:a 128k "$OUTPUT"
        return
    fi

    CLEANUP=$(mktemp -d)
    dir="$CLEANUP"
    run ffmpeg -y -v error -i "$INPUT" -map 0:v -start_number 0 -c:v jpeg2000 -compression_level 0 \
        "$dir/f_%05d.jp2"
    fps=$(get_video_fps "$INPUT")

    for ((i = 0; i < ns; i++)); do
        next=$( [ "$cur" = a ] && echo b || echo a )
        log "processing: ${SEG_TYPES[$i]} pass $((i + 1))/$ns"
        if [ "${SEG_TYPES[$i]}" = magick ]; then
            video_pass_magick "$dir" "$cur" "$next" "${SEG_ARGS[$i]}"
        else
            video_pass_ffmpeg "$dir" "$cur" "$next" "${SEG_ARGS[$i]}"
        fi
        cur="$next"
    done

    run ffmpeg -y -v error -r "$fps" -start_number 0 -i "$dir/${cur}_%05d.jp2" \
        -i "$INPUT" -map 0:v -map 1:a? -c:v libx264 -crf 18 -preset veryfast \
        -pix_fmt yuv420p -c:a aac -b:a 128k "$OUTPUT"
}

parse_args() {
    local p
    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h) help; exit 0;;
            --hidelogs) HIDE=1; shift;;
            --invert) add_fx invert; shift;;
            --invertlum) add_fx invertlum; shift;;
            --fisheye)
                shift; p=0.5
                if [ $# -gt 0 ] && is_num "$1"; then p=$1; shift; fi
                add_fx fisheye "$p"
                ;;
            --explode)
                shift; p=1.0
                if [ $# -gt 0 ] && is_num "$1"; then p=$1; shift; fi
                add_fx explode "$p"
                ;;
            --swirl)
                shift; p=45
                if [ $# -gt 0 ] && is_num "$1"; then p=$1; shift; fi
                add_fx swirl "$p"
                ;;
            --rotate)
                shift; p=90
                if [ $# -gt 0 ] && is_num "$1"; then p=$1; shift; fi
                add_fx rotate "$p"
                ;;
            --hsv)
                shift
                [ $# -eq 0 ] && err "'--hsv' requires a value like 180,0,0"
                add_fx hsv "$1"; shift
                ;;
            --hue)
                shift; p=90
                if [ $# -gt 0 ] && is_num "$1"; then p=$1; shift; fi
                add_fx hue "$p"
                ;;
            --hflip) add_fx hflip; shift;;
            --vflip) add_fx vflip; shift;;
            --magik) add_fx magik; shift;;
            --haah) add_fx haah; shift;;
            --waaw) add_fx waaw; shift;;
            --hooh) add_fx hooh; shift;;
            --woow) add_fx woow; shift;;
            --derain) add_fx derain; shift;;
            --rain) add_fx rain; shift;;
            --bgr) add_fx bgr; shift;;
            --stretch)
                shift; p="1.1,1.1"
                if [ $# -gt 0 ] && is_csv "$1"; then p=${1//;/,}; shift; fi
                if [[ "$p" != *,* ]]; then p="$p,$p"; fi
                add_fx stretch "$p"
                ;;
            --resize)
                shift
                [ $# -eq 0 ] && err "'--resize' requires a size like 1280x720, 500 or 50%"
                is_size "$1" || err "'--resize' requires a size like 1280x720, 500 or 50%"
                add_fx resize "$1"; shift
                ;;
            --wave)
                shift; p="3.2,3.2,0.05,0.05,0.628,0.628,0,0"
                if [ $# -gt 0 ] && is_csv "$1"; then p=$(pad_wave "${1//;/,}"); shift; fi
                add_fx wave "$p"
                ;;
            --*|-*) err "unknown option '$1' (see --help)";;
            *)
                if [ -z "$INPUT" ]; then
                    INPUT=$1
                elif [ -z "$OUTPUT" ]; then
                    OUTPUT=$1
                else
                    err "unexpected argument '$1' (see --help)"
                fi
                shift
                ;;
        esac
    done
}

main() {
    if [ "${1:-}" = install ] || [ "${1:-}" = --install ]; then
        install_me
        exit 0
    fi
    parse_args "$@"

    [ -n "$INPUT" ] && [ -n "$OUTPUT" ] || { help; err "missing input or output file"; }
    [ "$INPUT" != "$OUTPUT" ] || err "input and output are the same file: $INPUT"
    [ -f "$INPUT" ] || err "input file not found or unreadable: $INPUT"

    is_img "$INPUT" || is_vid "$INPUT" || err "unsupported input format .$(ext "$INPUT")"
    is_img "$OUTPUT" || is_vid "$OUTPUT" || err "unsupported output format .$(ext "$OUTPUT")"

    command -v magick >/dev/null || err "ImageMagick 'magick' not found on PATH"
    command -v ffmpeg >/dev/null || err "ffmpeg not found on PATH"

    log "input : $INPUT"
    log "output: $OUTPUT"

    local i
    for ((i = 0; i < ${#FX_TYPES[@]}; i++)); do
        write_effect_c "${FX_TYPES[$i]}" "${FX_PARAMS[$i]}"
    done

    if is_img "$INPUT"; then
        process_image
    else
        process_video
    fi
    log "done: $OUTPUT"
}

main "$@"
