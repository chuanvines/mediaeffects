    esac
    log "effect: $(fx_name "$name") -> $(fx_file "$name")"
}

run_fx_image() {
    local type="$1" p="$2" in="$3" out="$4" h s v vp sp hp
    case "$type" in
        invert) run magick "$in" -negate "$out";;
        invertlum) run magick "$in" -colorspace lab -channel r -negate +colorspace "$out";;
        fisheye) run ffmpeg -y -v error -i "$in" -vf "$(fisheye_vf "$p")" "$out";;
        hsv)
            IFS=, read -r h s v <<< "$p"
            read -r vp sp hp <<< "$(awk -v h="$h" -v s="$s" -v v="$v" \
                'BEGIN { printf "%d %d %d", 100+v, 100+s, 100 + h*100/180 }')"
            run magick "$in" -modulate "$vp,$sp,$hp" "$out"
            ;;
        hue) run magick "$in" -colorspace yuv -fx "angle=${p}*pi/180; channel(u,.5+(u.g-.5)*cos(angle)-(u.b-.5)*sin(angle),.5+(u.g-.5)*sin(angle)+(u.b-.5)*cos(angle))" -colorspace srgb "$out";;
        explode) run magick "$in" -implode "$(awk -v a="$p" 'BEGIN { printf "%.4f", -a }')" "$out";;
        swirl) run magick "$in" -swirl "$p" "$out";;
        hflip) run ffmpeg -y -v error -i "$in" -vf hflip "$out";;
        vflip) run ffmpeg -y -v error -i "$in" -vf vflip "$out";;
        rotate) run ffmpeg -y -v error -i "$in" -vf "rotate=${p}*3.141592653589793/180" "$out";;
        magik) run magick "$in" -liquid-rescale 50%x50% -resize 200% "$out";;
        haah) run magick "$in" -crop 50%x100%+0+0 +repage \( +clone -flop \) +append "$out";;
        waaw) run magick "$in" -flop -crop 50%x100%+0+0 +repage \( +clone -flop \) +append "$out";;
        hooh) run magick "$in" -rotate 90 -crop 50%x100%+0+0 +repage \( +clone -flop \) +append -rotate -90 "$out";;
        woow) run magick "$in" -rotate 90 -flop -crop 50%x100%+0+0 +repage \( +clone -flop \) +append -rotate -90 "$out";;
        stretch) run ffmpeg -y -v error -i "$in" -vf "$(stretch_vf "$p" "$(magick "$in" -format '%wx%h' info:)")" "$out";;
        wave) run ffmpeg -y -v error -i "$in" -vf "$(wave_vf "$p" "$(magick "$in" -format '%wx%h' info:)")" "$out";;
        resize) run magick "$in" -resize "$p" "$out";;
        derain) run magick "$in" -colorspace srgb -set colorspace rgb -colorspace hsv -set colorspace rgb "$out";;
        rain) run magick "$in" -colorspace srgb -set colorspace hsv -colorspace scrgb -set colorspace srgb "$out";;
        bgr) run magick "$in" -color-matrix 0,0,1,0,1,0,1,0,0 "$out";;
    esac
}

process_image() {
    local n=${#FX_TYPES[@]} i in="$INPUT" out
    if [ "$n" -eq 0 ]; then
        run magick "$INPUT" "$OUTPUT"
        return
    fi
    CLEANUP=$(mktemp -d)
    for ((i = 0; i < n; i++)); do
        if [ "$i" -eq $((n - 1)) ]; then out="$OUTPUT"; else out="$CLEANUP/fx_$i.png"; fi
        log "processing: ${FX_TYPES[$i]} (pass $((i + 1))/$n)"
        run_fx_image "${FX_TYPES[$i]}" "${FX_PARAMS[$i]}" "$in" "$out"
        in="$out"
    done
}

get_video_fps() {
    local fps
    fps=$(ffprobe -v error -select_streams v:0 -show_entries stream=avg_frame_rate \
          -of csv=p=0 -i "$1" 2>/dev/null || true)
    case "$fps" in "" | "0/0") echo 25;; *) echo "$fps";; esac
}

video_pass_magick() {
    local dir="$1" cur="$2" next="$3" args="$4" d="$1" nframes cores chunk hi start pid status=0 i num
    local -a pids=()
    # On MSYS2/Git Bash, native magick.exe cannot open POSIX /tmp paths, so
    # convert to a Windows path when cygpath is available (Linux passes through).
    if command -v cygpath >/dev/null 2>&1; then
        d=$(cygpath -w "$dir")
    fi
    nframes=$(ls "$dir/${cur}_"*.jpg 2>/dev/null | wc -l)
    if [ "$nframes" -le 1 ]; then
        # shellcheck disable=SC2086
        run magick "$d/${cur}_*.jpg" $args "$d/${next}_%05d.jpg"
        return
    fi
    cores=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)
    [ "$cores" -gt "$nframes" ] && cores=$nframes
    chunk=$(( (nframes + cores - 1) / cores ))
    if [[ "$args" == *"+append"* ]]; then
        # Mirror effects use +append/+clone which collapse a multi-frame
        # sequence into a single image, so apply them frame by frame.
        for ((start = 0; start < nframes; start += chunk)); do
            hi=$(( start + chunk - 1 ))
            [ "$hi" -ge "$nframes" ] && hi=$(( nframes - 1 ))
            (
                for ((i = start; i <= hi; i++)); do
                    num=$(printf '%05d' "$i")
                    # shellcheck disable=SC2086
                    magick "$d/${cur}_${num}.jpg" $args "$d/${next}_${num}.jpg" || exit 1
                done
            ) &
            pids+=("$!")
        done
    else
        # Process disjoint frame ranges in parallel; -scene keeps the output
        # numbering aligned with each chunk's starting frame.
        for ((start = 0; start < nframes; start += chunk)); do
            hi=$(( start + chunk - 1 ))
            [ "$hi" -ge "$nframes" ] && hi=$(( nframes - 1 ))
            # shellcheck disable=SC2086
            magick "$d/${cur}_%05d.jpg[$start-$hi]" $args -scene "$start" \
                "$d/${next}_%05d.jpg" &
            pids+=("$!")
        done
    fi
    for pid in "${pids[@]}"; do
        wait "$pid" || status=1
    done
    [ "$status" -eq 0 ] || err "magick frame pass failed"
}

video_pass_ffmpeg() {
    local dir="$1" cur="$2" next="$3" vf="$4"
    run ffmpeg -y -v error -start_number 0 -i "$dir/${cur}_%05d.jpg" -vf "$vf" \
        -start_number 0 "$dir/${next}_%05d.jpg"
}

process_video() {
    local dir fps dims cur=f next magick_args="" pending=0 n=${#FX_TYPES[@]} i
    if [ "$n" -eq 0 ]; then
        run ffmpeg -y -v error -i "$INPUT" -map 0:v -map 0:a? -c copy "$OUTPUT"
        return
    fi
    command -v ffprobe >/dev/null || err "ffprobe not found on PATH (needed for video)"
    CLEANUP=$(mktemp -d)
    dir="$CLEANUP"
    run ffmpeg -y -v error -i "$INPUT" -map 0:v -start_number 0 -c:v mjpeg -q:v 2 \
        "$dir/f_%05d.jpg"
    fps=$(get_video_fps "$INPUT")
    dims=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height \
           -of csv=s=x:p=0 "$INPUT")

    for ((i = 0; i < n; i++)); do
        if uses_ffmpeg "${FX_TYPES[$i]}"; then
            if [ "$pending" -eq 1 ]; then
                next=$( [ "$cur" = a ] && echo b || echo a )
                video_pass_magick "$dir" "$cur" "$next" "$magick_args"
                cur="$next"
                magick_args=""
                pending=0
            fi
            next=$( [ "$cur" = a ] && echo b || echo a )
            log "processing: ${FX_TYPES[$i]} (pass $((i + 1))/$n)"
            video_pass_ffmpeg "$dir" "$cur" "$next" "$(effect_vf "${FX_TYPES[$i]}" "${FX_PARAMS[$i]}" "$dims")"
            cur="$next"
        else
            magick_args="${magick_args}$(magick_arg "${FX_TYPES[$i]}" "${FX_PARAMS[$i]}")"
            pending=1
        fi
    done
    if [ "$pending" -eq 1 ]; then
        next=$( [ "$cur" = a ] && echo b || echo a )
        video_pass_magick "$dir" "$cur" "$next" "$magick_args"
        cur="$next"
    fi

    run ffmpeg -y -v error -r "$fps" -start_number 0 -i "$dir/${cur}_%05d.jpg" \
        -i "$INPUT" -map 0:v -map 1:a? -c:v libx264 -crf 18 -preset faster \
        -pix_fmt yuv420p -c:a aac -b:a 128k "$OUTPUT"
}

parse_args() {
    local p
    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h) help; exit 0;;
            --hidelogs) HIDE=1; shift;;
            --invert) add_fx invert; shift;;
            --invertlum) add_fx invertlum; shift;;
            --fisheye)
                shift; p=0.5
                if [ $# -gt 0 ] && is_num "$1"; then p=$1; shift; fi
                add_fx fisheye "$p"
                ;;
            --explode)
                shift; p=1.0
                if [ $# -gt 0 ] && is_num "$1"; then p=$1; shift; fi
                add_fx explode "$p"
                ;;
            --swirl)
                shift; p=45
                if [ $# -gt 0 ] && is_num "$1"; then p=$1; shift; fi
                add_fx swirl "$p"
                ;;
            --rotate)
                shift; p=90
                if [ $# -gt 0 ] && is_num "$1"; then p=$1; shift; fi
                add_fx rotate "$p"
                ;;
            --hsv)
                shift
                [ $# -eq 0 ] && err "'--hsv' requires a value like 180,0,0"
                add_fx hsv "$1"; shift
                ;;
            --hue)
                shift; p=90
                if [ $# -gt 0 ] && is_num "$1"; then p=$1; shift; fi
                add_fx hue "$p"
                ;;
            --hflip) add_fx hflip; shift;;
            --vflip) add_fx vflip; shift;;
            --magik) add_fx magik; shift;;
            --haah) add_fx haah; shift;;
            --waaw) add_fx waaw; shift;;
            --hooh) add_fx hooh; shift;;
            --woow) add_fx woow; shift;;
            --derain) add_fx derain; shift;;
            --rain) add_fx rain; shift;;
            --bgr) add_fx bgr; shift;;
            --stretch)
                shift; p="1.1,1.1"
                if [ $# -gt 0 ] && is_csv "$1"; then p=${1//;/,}; shift; fi
                if [[ "$p" != *,* ]]; then p="$p,$p"; fi
                add_fx stretch "$p"
                ;;
            --resize)
                shift
                [ $# -eq 0 ] && err "'--resize' requires a size like 1280x720, 500 or 50%"
                is_size "$1" || err "'--resize' requires a size like 1280x720, 500 or 50%"
                add_fx resize "$1"; shift
                ;;
            --wave)
                shift; p="3.2,3.2,0.05,0.05,0.628,0.628,0,0"
                if [ $# -gt 0 ] && is_csv "$1"; then p=$(pad_wave "${1//;/,}"); shift; fi
                add_fx wave "$p"
                ;;
            --*|-*) err "unknown option '$1' (see --help)";;
            *)
                if [ -z "$INPUT" ]; then
                    INPUT=$1
                elif [ -z "$OUTPUT" ]; then
                    OUTPUT=$1
                else
                    err "unexpected argument '$1' (see --help)"
                fi
                shift
                ;;
        esac
    done
}

main() {
    if [ "${1:-}" = install ] || [ "${1:-}" = --install ]; then
        install_me
        exit 0
    fi
    parse_args "$@"

    [ -n "$INPUT" ] && [ -n "$OUTPUT" ] || { help; err "missing input or output file"; }
    [ "$INPUT" != "$OUTPUT" ] || err "input and output are the same file: $INPUT"
    [ -f "$INPUT" ] || err "input file not found or unreadable: $INPUT"

    is_img "$INPUT" || is_vid "$INPUT" || err "unsupported input format .$(ext "$INPUT")"
    is_img "$OUTPUT" || is_vid "$OUTPUT" || err "unsupported output format .$(ext "$OUTPUT")"

    command -v magick >/dev/null || err "ImageMagick 'magick' not found on PATH"
    command -v ffmpeg >/dev/null || err "ffmpeg not found on PATH"

    log "input : $INPUT"
    log "output: $OUTPUT"

    local i
    for ((i = 0; i < ${#FX_TYPES[@]}; i++)); do
        write_effect_c "${FX_TYPES[$i]}" "${FX_PARAMS[$i]}"
    done

    if is_img "$INPUT"; then
        process_image
    else
        process_video
    fi
    log "done: $OUTPUT"
}

main "$@"
